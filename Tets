-- LEMONHUB WALKING AUTO LEFT / RIGHT
-- ============================================================
local function faceSouth()
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if root then root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, 0, 0) end
end

local function faceNorth()
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if root then root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(180), 0) end
end

local autoLeftPhase = 1
local autoRightPhase = 1

local function startAutoLeft()
    if Conns.autoLeft then Conns.autoLeft:Disconnect() end
    State.autoLeftEnabled = true
    autoLeftPhase = 1
    Conns.autoLeft = RunService.Heartbeat:Connect(function()
        if not State.autoLeftEnabled then return end
        local char = LP.Character if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end
        local spd = State.normalSpeed
        if autoLeftPhase == 1 then
            local target = Vector3.new(LEMON_POS.L1.X, root.Position.Y, LEMON_POS.L1.Z)
            if (target - root.Position).Magnitude < 1 then
                autoLeftPhase = 2
                local dir = (LEMON_POS.L2 - root.Position).Unit
                hum:Move(dir, false)
                root.AssemblyLinearVelocity = Vector3.new(dir.X * spd, root.AssemblyLinearVelocity.Y, dir.Z * spd)
                return
            end
            local dir = (LEMON_POS.L1 - root.Position).Unit
            hum:Move(dir, false)
            root.AssemblyLinearVelocity = Vector3.new(dir.X * spd, root.AssemblyLinearVelocity.Y, dir.Z * spd)
        elseif autoLeftPhase == 2 then
            local target = Vector3.new(LEMON_POS.L2.X, root.Position.Y, LEMON_POS.L2.Z)
            if (target - root.Position).Magnitude < 1 then
                hum:Move(Vector3.zero, false)
                root.AssemblyLinearVelocity = Vector3.zero
                State.autoLeftEnabled = false
                if Conns.autoLeft then Conns.autoLeft:Disconnect(); Conns.autoLeft = nil end
                autoLeftPhase = 1
                faceSouth()
                if stackBtnRefs.autoLeft then stackBtnRefs.autoLeft.setOn(false) end
                return
            end
            local dir = (LEMON_POS.L2 - root.Position).Unit
            hum:Move(dir, false)
            root.AssemblyLinearVelocity = Vector3.new(dir.X * spd, root.AssemblyLinearVelocity.Y, dir.Z * spd)
        end
    end)
    if stackBtnRefs.autoLeft then stackBtnRefs.autoLeft.setOn(true) end
end

local function stopAutoLeft()
    State.autoLeftEnabled = false
    if Conns.autoLeft then Conns.autoLeft:Disconnect(); Conns.autoLeft = nil end
    autoLeftPhase = 1
    local char = LP.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum:Move(Vector3.zero, false) end
    end
    if stackBtnRefs.autoLeft then stackBtnRefs.autoLeft.setOn(false) end
end

local function startAutoRight()
    if Conns.autoRight then Conns.autoRight:Disconnect() end
    State.autoRightEnabled = true
    autoRightPhase = 1
    Conns.autoRight = RunService.Heartbeat:Connect(function()
        if not State.autoRightEnabled then return end
