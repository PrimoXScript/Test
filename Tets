            hum:Move(dir, false)
            root.AssemblyLinearVelocity = Vector3.new(dir.X * spd, root.AssemblyLinearVelocity.Y, dir.Z * spd)
        elseif autoRightPhase == 2 then
            local target = Vector3.new(LEMON_POS.R2.X, root.Position.Y, LEMON_POS.R2.Z)
